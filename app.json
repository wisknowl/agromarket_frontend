{
  "expo": {
    "name": "Agrom",
    "slug": "agromarket",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/agromarket.png",
    "scheme": "agromarket",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/agromarket.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wisknowl.agromarket",
      "infoPlist": {
        "NSCameraUsageDescription": "AgroMarket needs access to your camera to take and upload photos of harvest produce and farm verification documents.",
        "NSPhotoLibraryUsageDescription": "AgroMarket needs access to your photo library to select photos of harvest yields, farm facilities, and profile pictures.",
        "NSMicrophoneUsageDescription": "AgroMarket needs access to your microphone to record and send voice notes in direct chat with farmers and buyers."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/agromarket.png",
        "backgroundColor": "#ffffff"
      },
      "splash": {
        "image": "./assets/images/agromarket.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff"
      },
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.wisknowl.agromarket"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-navigation-bar",
        {
          "position": "relative",
          "backgroundColor": "#ffffff",
          "buttonStyle": "dark"
        }
      ],
      "expo-font",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4f92ecda-bb28-41f4-881f-424d5e73b3f0"
      }
    }
  }
}
